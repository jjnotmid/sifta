{
  "name": "sifta",
  "version": "0.1.0",
  "description": "Agentic AML investigation memory for African financial institutions",
  "license": "MIT",
  "author": "Usifoh Joshua Eseosa",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:up": "./scripts/db-up.sh",
    "db:down": "./scripts/db-down.sh",
    "migrate": "tsx src/memory/migrate.ts",
    "ingest:ofac": "tsx src/ingest/cli-ofac.ts",
    "ingest:variants": "tsx src/ingest/cli-variants.ts",
    "eval": "tsx src/eval/cli.ts",
    "build:lambda": "tsx scripts/build-lambda.ts",
    "verify": "tsx scripts/verify.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "eval:snapshot": "tsx scripts/eval-snapshot.ts",
    "eval:example": "tsx scripts/worked-example.ts",
    "eval:field": "tsx scripts/field-snapshot.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1101.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.10.1",
    "groq-sdk": "^1.5.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
