# ---------------------------------------------------------------------------
# Sifta environment
# Copy to .env and fill in. Every value below has a working local default
# except the cloud credentials, which are only needed from Phase 6 onward.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local single-node CockroachDB (see `npm run db:up`).
DATABASE_URL=postgresql://root@localhost:26257/sifta?sslmode=disable

# CockroachDB Cloud. Least-privilege service account, never root.
# DATABASE_URL=postgresql://sifta_app:<password>@<host>:26257/sifta?sslmode=verify-full
# Only needed if your cluster requires the downloaded root.crt. Most Cloud
# clusters present a publicly-signed cert and Node's own CA bundle suffices.
# DATABASE_CA_CERT=/Users/you/.postgresql/root.crt

# --- Providers -------------------------------------------------------------
# mock | bedrock | groq
PROVIDER=mock
# mock | titan | local
EMBEDDING_PROVIDER=mock

# Embedding width. Must match the VECTOR(n) columns in db/schema.sql.
# Titan Text Embeddings V2 = 1024. Transformers.js all-MiniLM-L6-v2 = 384.
EMBEDDING_DIMENSIONS=1024

# --- AWS (Phase 6/7) -------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# S3 bucket for raw list snapshots and audit exports
# S3_BUCKET=sifta-artifacts

# --- Groq fallback ---------------------------------------------------------
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- CockroachDB Cloud MCP Server (read-only) ------------------------------
CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
# Service-account API key (Cloud console → service account → API key).
# CRDB_MCP_API_KEY=
# Which cluster the MCP server should act against. The Cloud Connect dialog
# gives you this — it is the UUID in the cert URL and the `mcp-cluster-id`
# header. Without it the server has no target.
# CRDB_MCP_CLUSTER_ID=
